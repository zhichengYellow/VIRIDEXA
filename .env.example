# Create or update a local .env with scripts/dev-env.sh. Values below are placeholders only.
MYSQL_ROOT_PASSWORD=replace-with-a-local-random-secret
MYSQL_APP_PASSWORD=replace-with-a-random-read-only-app-secret
MYSQL_MIGRATOR_PASSWORD=replace-with-a-different-random-migration-secret
MYSQL_IMPORTER_PASSWORD=replace-with-a-different-random-import-secret
VIRIDEXA_DATA_DIR=./data

# Generated locally by scripts/pipeline/provision_governance.py after Flyway.
MYSQL_REVIEW_PASSWORD=replace-with-a-generated-hex-service-secret

# Research Agent: optional external model. Never commit real credentials.
AGENT_MODEL_ENABLED=false
# Keep a real key in the server process environment; never commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_MODEL_ALLOWLIST=openrouter/free
AGENT_USER_DAILY_REQUESTS=20
AGENT_GLOBAL_DAILY_REQUESTS=200
AGENT_USER_DAILY_TOKENS=30000
AGENT_GLOBAL_DAILY_TOKENS=300000
# Optional configured USD estimates; no price is assumed.
AGENT_INPUT_COST_PER_MILLION=
AGENT_OUTPUT_COST_PER_MILLION=

# Enable only behind the deployed HTTPS origin; local HTTP uses false.
SESSION_COOKIE_SECURE=false

# Server-only public account database identity; provision_public_accounts.py generates it locally.
MYSQL_ACCOUNT_PASSWORD=

# Phase 7S: local defaults; public deployment must use compose.production.yaml.
TURNSTILE_ENABLED=false
TURNSTILE_MODE=production
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
TRUSTED_PROXY_CIDRS=
API_DOCS_ENABLED=true
# New zones were observed and enforced in isolated local checks. Set on for initial server observation.
VIRIDEXA_NGINX_OBSERVE=off
VIRIDEXA_NGINX_RATE_API=20r/s
VIRIDEXA_NGINX_RATE_SEARCH=8r/s
VIRIDEXA_NGINX_RATE_AUTH=10r/m
VIRIDEXA_NGINX_RATE_AGENT=2r/s
VIRIDEXA_NGINX_RATE_ADMIN=10r/m
# Optional conservative monetary caps, in the same currency as configured per-million token prices.
AGENT_USER_DAILY_COST=
AGENT_GLOBAL_DAILY_COST=
