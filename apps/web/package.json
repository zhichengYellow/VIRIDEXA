{
  "name": "@viridexa/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b --pretty",
    "test": "node --experimental-strip-types --test src/graph/__tests__/*.test.ts src/assistant/__tests__/*.test.ts src/workbench/__tests__/*.test.ts src/onboarding/__tests__/*.test.ts src/account/__tests__/*.test.ts src/security/__tests__/*.test.ts src/ui/__tests__/*.test.ts",
    "postbuild": "node scripts/check-static-assets.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy:cloudflare": "wrangler deploy",
    "preview:cloudflare": "wrangler dev --ip 127.0.0.1"
  },
  "dependencies": {
    "cytoscape": "3.34.4",
    "echarts": "6.1.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13",
    "wrangler": "4.154.0"
  }
}
