# Project-local research inputs are private/large and must never enter Git.
# This includes papers, source images with unknown redistribution rights, SP2000,
# iPlant, extracted tables, SQL archives and generated pipeline output.
# Ignore rules do not protect data from git clean; never clean these directories.
/data/
/database/

# Rebuildable pipeline outputs and local environment.
.venv/
.env
.env.*
!.env.example
**/target/
**/node_modules/
**/dist/
**/.vite/
*.log
.DS_Store

# Rebuildable scientific staging spools (existing reviewed historical reports remain tracked)
reports/**/candidates.jsonl
__pycache__/

# Local Agent budget ledger (no scientific inputs)
.runtime/

# Raw acceptance runs may contain source payloads, large screenshots or local paths.
# Curated, sanitized release evidence belongs in docs/release-evidence/.
/reports/
*.pem
*.key
*.p12
*.pfx
*.jks
*.sql.gz
*.dump

# Local Cloudflare emulator/cache and secret files
**/.wrangler/
**/.dev.vars
**/.dev.vars.*
