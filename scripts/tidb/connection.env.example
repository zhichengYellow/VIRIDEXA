# Copy to ignored .runtime/tidb.env, chmod 600, and fill values locally.
# Use a fresh database; no credentials in chat or Git.
TIDB_JDBC_URL='jdbc:mysql://<gateway>.tidbcloud.com:4000/viridexa_tidb_20261031?sslMode=VERIFY_IDENTITY&serverTimezone=UTC&forceConnectionTimeZoneToSession=true'
TIDB_MIGRATOR_USER=''
TIDB_MIGRATOR_PASSWORD=''

# Explicit Starter compatibility: table-scoped writes limited to the reviewed grant list.
# Leave column-scoped on targets with verified column-privilege support.
TIDB_PERMISSION_MODE='table-scoped'
